// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING   
  APPROVED  
  REJECTED  
  CANCELLED
}

model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String?
  branch          String
  role            Role         @default(USER)
  provider        String       @default("local")
  picture         String?  
  lineId          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  publicPosts     PublicPost[]
  themeSettings   Json?
}


model Room {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  category     String     @default("ห้องเรียนทั่วไป")
  building     String     @default("อาคาร 1")
  schedules    Schedule[]
  bookings     Booking[]
  publicPosts  PublicPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


model Schedule {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  day       String
  period    String
  subject   String
  teacher   String   @default("-")
  classroom String   @default("-")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([roomId, day, period])
}

model Booking {
  id            Int           @id @default(autoincrement())
  roomId        Int
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        Int?        
  userName      String   
  userEmail     String?     
  phone         String?     
  lineId        String?   
  day           String       
  date          String  
  checkInTime   DateTime?
  checkOutTime  DateTime?
  period        String           
  purpose       String       
  status        BookingStatus @default(PENDING) 
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PostCategory {
  GENERAL
  DAMAGED
  LOST
  FOUND
  MAINTENANCE
}

model PublicPost {
  id         Int          @id @default(autoincrement())
  category   PostCategory
  title      String
  message    String
  location   String?
  imageUrl   String?      @db.Text
  startDate  DateTime?
  endDate    DateTime?
  resolved   Boolean      @default(false)

  roomId     Int?
  room       Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  authorId   Int
  author     User         @relation(fields: [authorId], references: [id])

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([category])
  @@index([createdAt])
  @@index([roomId])
}